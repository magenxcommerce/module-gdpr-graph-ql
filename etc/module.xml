<?xml version="1.0"?>
<!--
  Companion GraphQL module for Magenx_Gdpr.

  Magenx_Gdpr owns the cookie registry / consent log / data-subject-request
  data, admin UI and cron. This module only adds the GraphQL surface over
  that data - the same split Magento uses for Catalog vs CatalogGraphQl -
  so the core module stays installable (and testable) without pulling in
  Magento_GraphQl.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Magenx_GdprGraphQl">
        <sequence>
            <module name="Magenx_Gdpr"/>
            <module name="Magento_Customer"/>
            <module name="Magento_Sales"/>
            <module name="Magento_GraphQl"/>
        </sequence>
    </module>
</config>
